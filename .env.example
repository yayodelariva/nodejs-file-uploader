# --- Database -------------------------------------------------------------
# Standard TCP connection:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/file_uploader?schema=public"
# Local Postgres using peer auth over a unix socket instead:
# DATABASE_URL="postgresql://USER@localhost/file_uploader?schema=public&host=/var/run/postgresql"

# Non-pooled connection, used for migrations. Locally this is the same as
# DATABASE_URL; on a serverless host DATABASE_URL points at the pooler (port
# 6543 on Supabase) while this one stays on the direct port (5432).
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/file_uploader?schema=public"

# --- Server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me"

# --- Uploads --------------------------------------------------------------
# Maximum accepted upload size in megabytes.
MAX_UPLOAD_MB=10

# Storage backend for uploaded files: local | supabase | cloudinary
STORAGE_PROVIDER=local
# Directory used by the "local" provider (relative paths resolve from the project root).
LOCAL_UPLOAD_DIR=uploads

# --- Supabase storage (STORAGE_PROVIDER=supabase) -------------------------
SUPABASE_URL=
# Use the service role key: uploads happen server-side.
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# --- Cloudinary (STORAGE_PROVIDER=cloudinary) -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=file-uploader
